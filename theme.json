{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1320px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"link": true,
			"background": true,
			"text": true,
			"palette": [
				{
					"slug": "base",
					"name": "Off-White",
					"color": "#FBF7F2"
				},
				{
					"slug": "surface",
					"name": "Weiß",
					"color": "#FFFFFF"
				},
				{
					"slug": "cream",
					"name": "Creme",
					"color": "#F4ECE3"
				},
				{
					"slug": "beige",
					"name": "Beige",
					"color": "#E8DCCD"
				},
				{
					"slug": "greige",
					"name": "Greige (alte Seite)",
					"color": "#E4E0D6"
				},
				{
					"slug": "contrast",
					"name": "Warmes Dunkelgrau",
					"color": "#3A3330"
				},
				{
					"slug": "muted",
					"name": "Warmes Grau",
					"color": "#6B5F58"
				},
				{
					"slug": "accent",
					"name": "Terrakotta-Rosé",
					"color": "#8C4639"
				},
				{
					"slug": "rose",
					"name": "Dusty Rose",
					"color": "#D9A9A0"
				},
				{
					"slug": "rose-light",
					"name": "Rosé hell",
					"color": "#F5E4DF"
				},
				{
					"slug": "pink",
					"name": "Pink (Logo)",
					"color": "#EF2F75"
				},
				{
					"slug": "sage",
					"name": "Salbei",
					"color": "#A8B5A0"
				},
				{
					"slug": "sage-light",
					"name": "Salbei hell",
					"color": "#E4E9DF"
				},
				{
					"slug": "sage-dark",
					"name": "Salbei dunkel",
					"color": "#5C6B55"
				},
				{
					"slug": "green",
					"name": "Hej-Lejo-Grün (Buttons)",
					"color": "#69755F"
				},
				{
					"slug": "green-old",
					"name": "Salbeigrün (alte Seite)",
					"color": "#818D77"
				},
				{
					"slug": "apricot",
					"name": "Apricot",
					"color": "#F2CBA9"
				},
				{
					"slug": "apricot-light",
					"name": "Apricot hell",
					"color": "#FAEBDD"
				},
				{
					"slug": "mustard",
					"name": "Senfgelb",
					"color": "#D4A23F"
				}
			]
		},
		"border": {
			"color": false,
			"radius": true,
			"style": false,
			"width": false
		},
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true
		},
		"position": {
			"sticky": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "soft",
					"name": "Dezent",
					"shadow": "0 6px 24px -12px rgba(58, 51, 48, 0.18)"
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "S",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "clamp(1rem, 0.9rem + 0.5vw, 1.25rem)"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "clamp(1.5rem, 1.25rem + 1vw, 2rem)"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "clamp(2rem, 1.5rem + 2vw, 3rem)"
				},
				{
					"slug": "60",
					"name": "2XL",
					"size": "clamp(2.5rem, 1.75rem + 3vw, 4.5rem)"
				},
				{
					"slug": "70",
					"name": "3XL",
					"size": "clamp(3.5rem, 2.5rem + 4vw, 6.5rem)"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontStyle": true,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"name": "Quicksand (Standard)",
					"slug": "sans",
					"fontFamily": "Quicksand, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Quicksand",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/quicksand-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"name": "Cormorant Garamond (optional, Akzente)",
					"slug": "serif",
					"fontFamily": "\"Cormorant Garamond\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cormorant-garamond-latin-wght-normal.woff2"
							]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "italic",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cormorant-garamond-latin-wght-italic.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "XS",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "S",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "M",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "L",
					"size": "1.25rem",
					"fluid": {
						"min": "1.1875rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "XL",
					"size": "1.75rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2.125rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "XXL",
					"size": "2.5rem",
					"fluid": {
						"min": "2rem",
						"max": "3rem"
					}
				},
				{
					"slug": "huge",
					"name": "Hero",
					"size": "3.75rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": false
				}
			},
			"core/image": {
				"lightbox": {
					"allowEditing": true
				}
			},
			"core/paragraph": {
				"typography": {
					"fontStyle": false
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"right": "var:preset|spacing|30",
				"bottom": "0px",
				"left": "var:preset|spacing|30"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "500",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|accent"
					}
				},
				":focus": {
					"color": {
						"text": "var:preset|color|accent"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontWeight": "500",
					"lineHeight": "1.15",
					"letterSpacing": "-0.005em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"lineHeight": "1.3"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600",
					"lineHeight": "1.4",
					"letterSpacing": "0"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"lineHeight": "1.4",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|green",
					"text": "var:preset|color|surface"
				},
				"border": {
					"radius": "6px",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"right": "1.6rem",
						"bottom": "0.8rem",
						"left": "1.6rem"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"lineHeight": "1.3",
					"letterSpacing": "0.02em",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|surface"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|surface"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|x-small"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "1.75rem",
					"fontWeight": "400",
					"lineHeight": "1",
					"letterSpacing": "0.04em",
					"textTransform": "uppercase"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|contrast"
							}
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|x-small"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var:preset|font-size|x-small"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-large",
					"fontStyle": "italic",
					"lineHeight": "1.35"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|beige"
				}
			},
			"core/image": {
				"border": {
					"radius": "10px"
				}
			},
			"core/cover": {
				"border": {
					"radius": "0px"
				}
			},
			"core/details": {
				"spacing": {
					"padding": {
						"top": "1.1rem",
						"bottom": "1.1rem"
					}
				}
			},
			"core/search": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"woocommerce/product-price": {
				"typography": {
					"fontWeight": "600"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landingpage (volle Breite, ohne Titel)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-narrow",
			"title": "Textseite (schmal, z. B. Rechtliches)",
			"postTypes": [
				"page"
			]
		}
	],
	"templateParts": [
		{
			"name": "announcement",
			"title": "Hinweisleiste",
			"area": "uncategorized"
		},
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "header-checkout",
			"title": "Header (Kasse)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "post-card",
			"title": "Beitragskarte",
			"area": "uncategorized"
		}
	]
}
